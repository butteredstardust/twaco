{
  "source": "ThingWorx 10.2 Composer, scripts/twx-Builder-bundle: the property mappings of the widget migrators (getXxxMUs, and the same-type table keyed by widget). Only plain renames (old name to new name) are listed; value maps, deletions and creations are not. Names that are events or services of the new widget, and names the new widget still has, are left out.",
  "renames": {
    "ptcsbutton": {"Alignment": "LabelAlignment", "ContextId": "ContextID", "Text": "Label", "ToolTipField": "TooltipField"},
    "ptcscheckbox": {"Prompt": "Label", "ToolTipField": "TooltipField"},
    "ptcschartbar": {"ChartTitle": "Label", "LegendLocation": "LegendPosition", "SecondaryYAxisFormat": "SecondYAxisFormat", "SecondaryYAxisTitle": "SecondYAxisLabel", "XAxisLabelRotation": "HorizontalAxisLabelsRotation"},
    "ptcschartline": {"ChartTitle": "Label", "LegendLocation": "LegendPosition", "SecondaryYAxisFormat": "SecondYAxisFormat", "SecondaryYAxisTitle": "SecondYAxisLabel", "XAxisLabelRotation": "HorizontalAxisLabelsRotation"},
    "ptcschartpie": {"ChartTitle": "Label", "ColorFormat": "DataStyle", "LabelField": "DataField", "LegendLocation": "LegendPosition", "LegendWidth": "LegendMaxWidth"},
    "ptcscollection": {"CellMashupSelectedField": "SelectedCellMashupField", "CellMenuStates": "CellMenu", "CellMenuStatesIconSize": "CellMenuIconSize", "EmptyMashupName": "EmptyMashup", "MashupHeight": "CellHeight"},
    "ptcsdatepicker": {"DateDisplay": "MonthFormat", "DateFormatToken": "FormatToken", "ToolTipField": "TooltipField"},
    "ptcsdropdown": {"TextIfNoSelection": "HintText"},
    "ptcsdynamicpanel": {"CollapseByDefault": "Collapsed"},
    "ptcsfileupload": {"DeleteAllButtonLabel": "RemoveAllButtonLabel", "DisplayPathTextBox": "ShowRepositoryPath", "DisplayRepositorySelector": "ShowRepositorySelector", "FileName": "FileNames", "FullPath": "FullPaths", "MaximumFileSize": "MaxFileSize", "ShowDeleteAllButton": "ShowRemoveAllButton"},
    "ptcsgrid": {"CookiePersistence": "CacheRuntimeChanges", "DeletedTable": "DeletedData", "EditedTable": "EditedData", "RowHeight": "MinRowHeight"},
    "ptcslabel": {"Alignment": "HorizontalAlignment", "Text": "LabelText", "ToolTipField": "TooltipField"},
    "ptcslink": {"Href": "LinkURL", "SourceURL": "LinkURL"},
    "ptcsslider": {"Step": "StepSize"},
    "ptcstabset": {"CurrentTab": "SelectedTab", "DefaultTabAtRuntime": "DefaultTabNumber", "MaxTabWidth": "TabNameMaxWidth"},
    "ptcstextarea": {"PlaceholderText": "HintText", "ToolTipField": "TooltipField"},
    "ptcstextfield": {"AllowNegatives": "AllowNegativeValues", "FixedDigits": "DecimalPlaces", "Maximum": "MaxValue", "MaskInputCharacters": "Password", "Minimum": "MinValue", "PlaceholderText": "HintText", "TextAlign": "TextAlignment", "ToolTipField": "TooltipField", "ValueAlign": "TextAlignment"},
    "ptcsvaluedisplay": {"Alignment": "HorizontalAlignment", "ToolTipField": "TooltipField"},
    "navigationfunction": {"FixedPopupHeight": "PopupHeight", "FixedPopupWidth": "PopupWidth", "MashupName": "TargetMashup", "MessageToShow": "MissingMashupMessage", "PopupScrolling": "PopupScrollbar", "ShowCloseButton": "CloseButton", "TargetWindow": "TargetWindowType"}
  },
  "values_differ": {"navigationfunction": ["TargetWindow"]},
  "newtypes_source": {
    "platform": "10.2",
    "bundle_sha256": "a950d01c1d76ec446347ad26e9e40215a5f7839365e3a01fcadec52c23d46045",
    "note": "Curated declarative newtype overlay from Composer ptcs-migration modules. Collection configuration and numeric input mode are translated in authoring/migrate.rs. Container applies only under ptcsdynamicpanel. Theme style callbacks are not executed: unmapped properties are reported as dropped."
  },
  "newtypes": {
    "collection": {
      "newtype": "ptcscollection",
      "create": {
        "CellTabKeyScope": "item"
      },
      "mappings": {
        "MashupHeight": "CellHeight",
        "CellMashupSelectedField": "SelectedCellMashupField",
        "CellMenuStates": "CellMenu",
        "CellMenuStatesIconSize": "CellMenuIconSize",
        "CellWasClicked": "CellClicked",
        "CellWasDoubleClicked": "CellDoubleClicked",
        "CellWasLongClicked": "CellLongClicked",
        "CellWasRightClicked": "CellRightClicked",
        "CellPointer": "CellPointer",
        "regExp___^(Menu):.*$": "CellMenu",
        "EmptyMashupName": "EmptyMashup",
        "FlowLayoutAlignment": {
          "newproperty": "RowVerticalAlignment",
          "values": {
            "Bottom": "bottom",
            "Center": "center",
            "Expand": "stretch",
            "Top": "top"
          }
        },
        "FlowLayoutGravity": {
          "newproperty": "RowHorizontalAlignment",
          "values": {
            "Center": "center",
            "Edge": "space-between",
            "Expand": "stretch",
            "Left": "left",
            "Spaced": "space-evenly"
          }
        },
        "FooterMashupName": "FooterMashup",
        "HeaderMashupName": "HeaderMashup",
        "ItemLoadBehavior": {
          "newproperty": "ItemLoadBehavior",
          "values": {
            "loadUnload": "lazy",
            "loadAll": "load-all"
          }
        },
        "LeftAlignFinalRow": "LeftAlignLastRow",
        "ScrollsToSelectedCell": "ScrollToSelectedCell",
        "SectionInsetLeft": "LeftPadding",
        "SectionInsetRight": "RightPadding",
        "SelectedItems": "SelectedCells",
        "SelectedMashupName": "SelectedCellMashup",
        "View": {
          "newproperty": "Layout",
          "values": {
            "flow": "flex",
            "table": "table"
          }
        },
        "UseMashupDimensions": "UseMashupDimensions"
      },
      "deletions": [
        "AllowSelection",
        "CellMenuStatesIconGravity",
        "CellMenuStatesOrientation",
        "CellMenuStatesUseBuiltin",
        "CellMultipleSelectionType",
        "FlowLayoutContentGravity",
        "MultiSelect",
        "OffScreenBufferFactor",
        "PinFootersToBottom",
        "PinHeadersToTop",
        "PlaysIntroAnimation",
        "ScrollbarType",
        "SectionInsetBottom",
        "SectionInsetLeft",
        "SectionInsetRight",
        "SectionInsetTop",
        "ShowFooters",
        "ShowHeaders",
        "UseCustomScrollerOnWindowsDesktops",
        "UseRippleEffect",
        "_EventDataShape",
        "_CanDoubleClick",
        "_MenuDefinition",
        "_GlobalDataShape"
      ]
    },
    "numericentry": {
      "newtype": "ptcstextfield",
      "mappings": {
        "AllowNegatives": "AllowNegativeValues",
        "FixedDigits": "DecimalPlaces",
        "Maximum": "MaxValue",
        "Minimum": "MinValue",
        "Value": "NumericValue",
        "ToolTipField": "TooltipField",
        "ValueAlign": "TextAlignment"
      },
      "create": {
        "NumericInputMode": true,
        "ShowValidationFailure": true
      }
    },
    "container": {
      "newtype": "flexcontainer",
      "deletions": [
        "Margin"
      ]
    },
    "label": {
      "newtype": "ptcslabel",
      "mappings": {
        "CustomClass": "CustomClass",
        "Text": "LabelText",
        "Alignment": "HorizontalAlignment",
        "ToolTipField": "TooltipField"
      },
      "deletions": [
        "ShowDataLoading"
      ]
    },
    "checkbox": {
      "newtype": "ptcscheckbox",
      "mappings": {
        "Prompt": "Label",
        "CustomClass": "CustomClass",
        "ToolTipField": "TooltipField"
      },
      "deletions": [
        "ShowDataLoading"
      ]
    },
    "divider": {
      "newtype": "ptcsdivider",
      "mappings": {
        "CustomClass": "CustomClass"
      },
      "deletions": [
        "ShowDataLoading",
        "ToolTipField"
      ]
    },
    "textbox": {
      "newtype": "ptcstextfield",
      "mappings": {
        "CustomClass": "CustomClass",
        "PlaceholderText": "HintText",
        "MaskInputCharacters": "Password",
        "ToolTipField": "TooltipField",
        "TextAlign": "TextAlignment"
      }
    },
    "textarea": {
      "newtype": "ptcstextarea",
      "mappings": {
        "CustomClass": "CustomClass",
        "ToolTipField": "TooltipField"
      }
    },
    "image": {
      "newtype": "ptcsimage",
      "mappings": {
        "CustomClass": "CustomClass",
        "Scaling": {
          "newproperty": "Scaling",
          "values": {
            "height": "fit-y",
            "width": "fit-x",
            "none": "fit"
          }
        }
      },
      "deletions": [
        "ToolTipField"
      ]
    },
    "link": {
      "newtype": "ptcslink",
      "mappings": {
        "CustomClass": "CustomClass",
        "SourceURL": "LinkURL",
        "TargetWindow": {
          "newproperty": "TargetWindow",
          "values": {
            "new": "_blank",
            "replace": "_self",
            "popup": "_popup"
          }
        },
        "ToolTipField": "TooltipField"
      },
      "create": {
        "VerticalAlignment": "center"
      },
      "deletions": [
        "LinkDisplay"
      ]
    }
  }
}
