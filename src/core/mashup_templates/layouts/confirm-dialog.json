{
  "name": "confirm-dialog",
  "summary": "Confirmation message with close and action areas",
  "aliases": [
    "confirm"
  ],
  "page": {
    "flex-direction": "column",
    "align-items": "stretch"
  },
  "master_slot": "message",
  "children": [
    {
      "slot": "close",
      "flex-direction": "row",
      "justify-content": "flex-end",
      "align-items": "center",
      "fixed": "42px"
    },
    {
      "slot": "message",
      "flex-direction": "column",
      "flex-grow": 1,
      "justify-content": "center",
      "align-items": "stretch"
    },
    {
      "slot": "actions",
      "flex-direction": "row",
      "justify-content": "flex-end",
      "align-items": "center",
      "fixed": "50px"
    }
  ]
}
