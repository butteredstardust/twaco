{
  "version": "v1",
  "rules": [
    { "id": "align.page", "when": { "element": "page" }, "decisions": { "align": "stretch" } },
    { "id": "align.kpi-value", "when": { "template": "kpi-tile", "slot": "value" }, "decisions": { "align": "center" } },
    { "id": "align.filter-column", "when": { "template": "filter-panel", "slot": ["filter-column", "filter-footer"] }, "decisions": { "align": "center" } },
    { "id": "align.start", "when": { "template": ["filter-panel", "form-2col"], "slot": ["filters", "form-columns"] }, "decisions": { "align": "flex-start" } },
    { "id": "align.bar", "when": { "element": "slot", "slot": ["title", "header", "footer", "toolbar", "actions", "close"] }, "decisions": { "align": "center" } },
    { "id": "align.slot", "when": { "element": "slot" }, "decisions": { "align": "stretch" } },

    { "id": "justify.header-bar", "when": { "template": ["header-sidebar", "sidebar-header"], "slot": "header" }, "decisions": { "justify": "space-between" } },
    { "id": "justify.filter-footer", "when": { "template": "filter-panel", "slot": "filter-footer" }, "decisions": { "justify": "space-between" } },
    { "id": "justify.end", "when": { "element": "slot", "slot": ["actions", "close"] }, "decisions": { "justify": "flex-end" } },
    { "id": "justify.centred-content", "when": { "template": ["kpi-tile", "confirm-dialog"], "slot": ["value", "message"] }, "decisions": { "justify": "center" } },

    { "id": "gutter.page-padded", "when": { "template": ["blank", "list-page", "tabs", "dashboard"], "element": "page" }, "decisions": { "gutter": "24" } },
    { "id": "gutter.page-hosted", "when": { "template": "tab-content", "element": "page" }, "decisions": { "gutter": "" } },
    { "id": "gutter.tab-content-slot", "when": { "template": "tab-content", "element": "slot" }, "decisions": { "gutter": "" } },
    { "id": "gutter.filters", "when": { "template": "filter-panel", "slot": "filters" }, "decisions": { "gutter": "" } },
    { "id": "gutter.filter-actions", "when": { "template": "filter-panel", "slot": "filter-footer" }, "decisions": { "gutter": "20" } },
    { "id": "gutter.filter-footer", "when": { "template": "filter-panel", "slot": "content" }, "decisions": { "gutter": "24" } },
    { "id": "gutter.tab-set", "when": { "element": "widget", "widget": "ptcstabset" }, "decisions": { "gutter": "" } },

    { "id": "surface.toolbar-band", "when": { "template": ["list-page", "tab-content"], "slot": "toolbar" }, "decisions": { "surface": { "background": "#F7F7F7" } } },
    { "id": "surface.filter-column", "when": { "template": "filter-panel", "slot": "filter-column" }, "decisions": { "surface": { "background": "#F7F7F7" } } },
    { "id": "surface.filter-children", "when": { "template": "filter-panel", "slot": ["filters", "filter-footer"] }, "decisions": { "surface": { "background": "inherit" } } },
    { "id": "surface.filter-rule", "when": { "template": "filter-panel", "element": "divider", "parent": "filter-column" }, "decisions": { "surface": { "background": "#E4E7E9" } } },
    { "id": "surface.filter-content", "when": { "template": "filter-panel", "slot": "content" }, "decisions": { "surface": { "background": "#ffffff" } } },

    { "id": "size.divider", "when": { "element": "divider" }, "decisions": { "size": { "fixed": "1px" } } },
    { "id": "size.title-70", "when": { "template": ["list-page", "tabs"], "slot": "title" }, "decisions": { "size": { "fixed": "70px" } } },
    { "id": "size.toolbar-50", "when": { "template": "list-page", "slot": "toolbar" }, "decisions": { "size": { "fixed": "50px" } } },
    { "id": "size.toolbar-48", "when": { "template": "tab-content", "slot": "toolbar" }, "decisions": { "size": { "fixed": "48px" } } },
    { "id": "size.header-50", "when": { "template": ["header-footer", "header-sidebar", "sidebar-header", "card"], "slot": "header" }, "decisions": { "size": { "fixed": "50px" } } },
    { "id": "size.form-bar-50", "when": { "template": ["form-dialog", "form-2col"], "slot": ["title", "actions"] }, "decisions": { "size": { "fixed": "50px" } } },
    { "id": "size.confirm-actions-50", "when": { "template": "confirm-dialog", "slot": "actions" }, "decisions": { "size": { "fixed": "50px" } } },
    { "id": "size.confirm-close-42", "when": { "template": "confirm-dialog", "slot": "close" }, "decisions": { "size": { "fixed": "42px" } } },
    { "id": "size.title-40", "when": { "template": ["kpi-tile", "dashboard"], "slot": "title" }, "decisions": { "size": { "fixed": "40px" } } },
    { "id": "size.footer-40", "when": { "template": "header-footer", "slot": "footer" }, "decisions": { "size": { "fixed": "40px" } } },
    { "id": "size.card-actions-46", "when": { "template": "card", "slot": "actions" }, "decisions": { "size": { "fixed": "46px" } } },
    { "id": "size.dashboard-tiles", "when": { "template": "dashboard", "slot": "tiles" }, "decisions": { "size": { "fixed": "240px" } } },
    { "id": "size.filter-column", "when": { "template": "filter-panel", "slot": "filter-column" }, "decisions": { "size": { "fixed": "280px" } } },
    { "id": "size.dashboard-main", "when": { "template": "dashboard", "slot": "main" }, "decisions": { "size": { "fill": 3 } } },
    { "id": "size.content-sidebar", "when": { "element": "slot", "slot": "sidebar" }, "decisions": { "size": "content" } },
    { "id": "size.content-fields", "when": { "template": "form-2col", "slot": "fields" }, "decisions": { "size": "content" } },
    { "id": "size.content-filter-footer", "when": { "template": "filter-panel", "slot": "filter-footer" }, "decisions": { "size": "content" } },
    { "id": "size.fill", "when": { "element": "slot" }, "decisions": { "size": "fill" } },

    { "id": "props.filter-range", "when": { "template": "filter-panel", "slot": ["filters", "filter-footer"] }, "decisions": { "props": { "flex-size": "range", "flex-shrink": 0 } } },
    { "id": "props.filters-width", "when": { "template": "filter-panel", "slot": "filters" }, "decisions": { "props": { "flex-min-width": "240px", "flex-max-width": "240px" } } },
    { "id": "props.filter-footer-width", "when": { "template": "filter-panel", "slot": "filter-footer" }, "decisions": { "props": { "flex-min-width": "280px", "flex-max-width": "280px", "Margin": "20" } } },
    { "id": "props.filter-rule-width", "when": { "template": "filter-panel", "element": "divider", "parent": "filter-column" }, "decisions": { "props": { "flex-min-width": "280px", "flex-max-width": "280px" } } },
    { "id": "props.form-column-basis", "when": { "template": "form-2col", "slot": ["left", "right"] }, "decisions": { "props": { "flex-basis": "0px" } } },

    { "id": "siblings.panel-row", "when": { "op": "equal-siblings", "facts": ["row-of-panels"] }, "decisions": { "siblings": "equal", "member_props": { "flex-grow": 1, "flex-shrink": 1, "flex-basis": "0px" } } },
    { "id": "siblings.row-content", "when": { "op": "equal-siblings" }, "decisions": { "siblings": "content" } },

    { "id": "size.row-compact", "when": { "op": "natural-height", "facts": ["compact"] }, "decisions": { "size": "content" } },
    { "id": "size.row-filler", "when": { "op": "natural-height", "facts": ["fills"] }, "decisions": { "size": "fill" } },
    { "id": "size.row-beside-filler", "when": { "op": "natural-height", "facts": ["column-fills"] }, "decisions": { "size": "content" } },
    { "id": "size.row-natural", "when": { "op": "natural-height" }, "decisions": { "size": "fill", "props": { "flex-shrink": 0 } } },

    { "id": "align.mixed-label-row", "when": { "op": "control-row", "facts": ["mixed-label-controls"] }, "decisions": { "align": "flex-end", "member_props": { "Margin": "0" } } },

    { "id": "props.toolbar-band", "when": { "op": "toolbar-band" }, "decisions": { "props": { "Margin": "", "UseTheme": true, "flex-direction": "row", "align-items": "center", "align-content": "flex-start", "justify-content": "flex-start", "flex-wrap": "nowrap", "ExpandCollapseTabLocation": "inside", "flex-size": "fixed", "flex-min-height": "48px", "flex-max-height": "48px", "flex-grow": 0, "flex-shrink": 0, "flex-basis": "auto", "ShowVerticalScrollbar": false } } },
    { "id": "props.card-recipe", "when": { "op": "card-recipe" }, "decisions": { "props": { "Margin": "8", "UseTheme": true, "flex-direction": "column", "flex-wrap": "nowrap", "align-items": "flex-start", "justify-content": "flex-start", "ExpandCollapseTabLocation": "inside", "ShowVerticalScrollbar": false, "flex-size": "range", "flex-min-height": "0px", "flex-max-height": "", "flex-grow": 0, "flex-shrink": 0, "flex-basis": "auto" } } },
    { "id": "props.panel-card-gutter", "when": { "op": "panel-recipe", "facts": ["style-card"] }, "decisions": { "props": { "Margin": "" } } },
    { "id": "props.panel-content-fit", "when": { "op": "panel-recipe", "facts": ["fit-content"] }, "decisions": { "props": { "flex-size": "default", "flex-min-height": "", "flex-grow": 0 } } },
    { "id": "props.panel-recipe", "when": { "op": "panel-recipe" }, "decisions": { "props": { "Style": "DefaultContainerStyle", "UseTheme": true, "Margin": "24 24 12", "flex-direction": "column", "flex-wrap": "nowrap", "align-items": "flex-start", "align-content": "flex-start", "justify-content": "flex-start", "flex-size": "range", "flex-min-height": "0px", "flex-max-height": "", "flex-grow": 1, "flex-shrink": 1, "flex-basis": "auto", "iconClass": "widgets-flexcontainer" } } },

    { "id": "props.toolbar-right", "when": { "op": "toolbar", "slot": "right" }, "decisions": { "props": { "justify-content": "flex-end" } } },
    { "id": "props.toolbar-row", "when": { "op": "toolbar", "slot": "row" }, "decisions": { "props": { "flex-size": "fixed", "flex-min-height": "48px", "flex-max-height": "48px", "iconClass": "widgets-flexcontainer-fixed" } } },
    { "id": "props.toolbar-group", "when": { "op": "toolbar" }, "decisions": { "props": { "Margin": "", "UseTheme": true, "ExpandCollapseTabLocation": "inside", "ShowVerticalScrollbar": false, "flex-direction": "row", "align-items": "center", "align-content": "flex-start", "flex-wrap": "nowrap", "justify-content": "flex-start" } } },

    { "id": "props.label-pairs-target", "when": { "op": "label-pairs", "slot": "target" }, "decisions": { "props": { "flex-direction": "column", "flex-wrap": "nowrap" } } },
    { "id": "props.label-pairs-header", "when": { "op": "label-pairs", "slot": "header" }, "decisions": { "props": { "Margin": "6 12 0", "flex-wrap": "nowrap" } } },
    { "id": "props.label-pairs-row", "when": { "op": "label-pairs", "slot": ["header", "row"] }, "decisions": { "props": { "Margin": "", "UseTheme": true, "ExpandCollapseTabLocation": "inside", "ShowVerticalScrollbar": false, "flex-direction": "row", "align-items": "flex-start", "align-content": "flex-start", "flex-wrap": "wrap", "flex-size": "range", "flex-min-height": "0px", "flex-max-height": "", "flex-grow": 0, "flex-shrink": 0 } } },
    { "id": "props.label-pairs-column", "when": { "op": "label-pairs", "slot": "column" }, "decisions": { "props": { "Margin": "0 12 12", "flex-direction": "column", "flex-wrap": "nowrap", "UseTheme": true, "ExpandCollapseTabLocation": "inside", "ShowVerticalScrollbar": false } } },

    { "id": "props.contained-tab", "when": { "op": "add-contained", "element": "tab", "facts": ["in-tab"] }, "decisions": { "props": { "flex-direction": "row", "flex-grow": 1, "flex-shrink": 1, "flex-basis": "auto", "flex-size": "default", "flex-min-height": "", "flex-max-height": "", "ExpandCollapseTabLocation": "inside" } } },
    { "id": "props.contained-in-tab", "when": { "op": "add-contained", "element": "widget", "widget": "mashupcontainer", "facts": ["in-tab"] }, "decisions": { "props": { "ResponsiveLayout": true, "Width": 400, "Height": 300 } } },
    { "id": "props.filter-footer-apply", "when": { "op": "add", "element": "widget", "widget": "ptcsbutton", "label": "Apply", "facts": ["in-filter-footer"] }, "decisions": { "props": { "ButtonType": "primary" } } },
    { "id": "props.filter-footer-reset", "when": { "op": "add", "element": "widget", "widget": "ptcsbutton", "label": "Reset", "facts": ["in-filter-footer"] }, "decisions": { "props": { "ButtonType": "tertiary" } } },
    { "id": "props.filter-footer-button", "when": { "op": "add", "element": "widget", "widget": "ptcsbutton", "facts": ["in-filter-footer"] }, "decisions": { "props": { "Width": 120, "Margin": "0" } } },
    { "id": "props.narrow-date", "when": { "op": "add", "element": "widget", "widget": "ptcsdatepicker", "facts": ["narrow-column"] }, "decisions": { "props": { "FormatToken": "DD-MM-YY", "DateOnly": true } } },

    { "id": "props.icon-fixed", "when": { "op": "set-flex-size", "facts": ["size-fixed"] }, "decisions": { "props": { "iconClass": "widgets-flexcontainer-fixed" } } },
    { "id": "props.icon-flex", "when": { "op": "set-flex-size" }, "decisions": { "props": { "iconClass": "widgets-flexcontainer" } } },
    { "id": "props.page-header", "when": { "op": "page-header" }, "decisions": { "props": { "flex-direction": "row", "align-items": "center", "flex-grow": 0, "flex-basis": "auto" } } },
    { "id": "props.page-kpi-row", "when": { "op": "page-kpi-row" }, "decisions": { "siblings": "equal", "props": { "flex-direction": "row", "align-items": "stretch" } } },
    { "id": "props.page-card", "when": { "op": "page-card" }, "decisions": { "props": { "flex-direction": "column" } } },
    { "id": "props.page-card-caption", "when": { "op": "page-card-caption" }, "decisions": { "props": { "LabelType": "label" } } },
    { "id": "props.page-control-row", "when": { "op": "page-control-row" }, "decisions": { "props": { "align-items": "center", "align-content": "center", "justify-content": "flex-start", "flex-wrap": "nowrap", "flex-min-height": "0px", "flex-max-height": "", "flex-size": "default" } } },
    { "id": "props.page-control-member", "when": { "op": "page-control-member" }, "decisions": { "props": { "flex-grow": 0, "flex-shrink": 0, "flex-basis": "auto" } } },
    { "id": "props.page-date-range", "when": { "op": "page-date-range" }, "decisions": { "props": { "Width": 340, "DateOnly": true, "FormatToken": "DD-MM-YY" } } },
    { "id": "props.page-date-range-narrow", "when": { "op": "page-date-range-narrow" }, "decisions": { "props": { "StartDateHintText": "From", "EndDateHintText": "To" } } },
    { "id": "props.page-chart-region", "when": { "op": "page-chart-region" }, "decisions": { "props": { "flex-size": "range", "flex-max-height": "", "flex-shrink": 0, "ShowVerticalScrollbar": false } } },
    { "id": "props.page-content-height", "when": { "op": "page-content-height" }, "decisions": { "props": { "flex-size": "range", "flex-min-height": "0px", "flex-max-height": "", "flex-grow": 0, "flex-shrink": 0, "flex-basis": "auto" } } },
    { "id": "props.page-panel-width", "when": { "op": "page-panel-width" }, "decisions": { "props": { "flex-grow": 1, "flex-shrink": 1, "flex-basis": "0px" } } },
    { "id": "props.page-slider-wrapper", "when": { "op": "page-slider-wrapper" }, "decisions": { "props": { "flex-direction": "column", "align-items": "stretch", "flex-grow": 0, "flex-shrink": 0, "flex-basis": "auto", "flex-size": "default", "flex-min-height": "", "flex-max-height": "" } } },
    { "id": "props.page-spacer", "when": { "op": "page-spacer" }, "decisions": { "props": { "flex-grow": 1, "flex-basis": "0px" } } }

  ]
}
