{
  "name": "card",
  "summary": "Card with a title, actions, and body",
  "aliases": [],
  "page": {
    "flex-direction": "column",
    "align-items": "@rule"
  },
  "master_slot": "body",
  "children": [
    {
      "slot": "header",
      "flex-direction": "row",
      "align-items": "@rule",
      "fixed": "@rule",
      "children": [
        {
          "slot": "title",
          "flex-direction": "row",
          "align-items": "@rule",
          "flex-grow": "@rule"
        },
        {
          "slot": "actions",
          "flex-direction": "row",
          "justify-content": "@rule",
          "align-items": "@rule",
          "fixed": "@rule"
        }
      ]
    },
    {
      "slot": "body",
      "flex-direction": "column",
      "flex-grow": "@rule",
      "align-items": "@rule"
    }
  ]
}
