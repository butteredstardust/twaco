{
  "name": "filter-panel",
  "summary": "Fixed filters beside flexible content",
  "aliases": [
    "filters"
  ],
  "page": {
    "flex-direction": "row",
    "align-items": "stretch"
  },
  "master_slot": "content",
  "children": [
    {
      "slot": "filter-column",
      "flex-direction": "column",
      "align-items": "center",
      "fixed": "290px",
      "style": {
        "background": "#F7F7F7"
      },
      "children": [
        {
          "slot": "filters",
          "flex-direction": "column",
          "align-items": "stretch",
          "flex-size": "range",
          "flex-min-width": "240px",
          "flex-max-width": "240px",
          "flex-shrink": 0,
          "Margin": "13 0 5",
          "style": {
            "background": "inherit"
          }
        }
      ]
    },
    {
      "divider": true
    },
    {
      "slot": "content",
      "flex-direction": "column",
      "flex-grow": 1,
      "align-items": "stretch",
      "Margin": "24",
      "style": {
        "background": "#ffffff"
      }
    }
  ]
}
