{
  "name": "filter-panel",
  "summary": "Fixed filters beside flexible content",
  "aliases": [
    "filters"
  ],
  "page": {
    "flex-direction": "row",
    "align-items": "@rule"
  },
  "master_slot": "content",
  "children": [
    {
      "slot": "filter-column",
      "flex-direction": "column",
      "align-items": "@rule",
      "fixed": "@rule",
      "style": "@rule",
      "children": [
        {
          "slot": "filters",
          "flex-direction": "column",
          "align-items": "@rule",
          "flex-size": "@rule",
          "flex-min-width": "@rule",
          "flex-max-width": "@rule",
          "flex-shrink": "@rule",
          "Margin": "@rule",
          "style": "@rule",
          "flex-grow": "@rule"
        },
        {
          "divider": true,
          "style": "@rule",
          "flex-min-width": "@rule",
          "flex-max-width": "@rule",
          "thickness": "@rule"
        },
        {
          "slot": "filter-footer",
          "flex-direction": "row",
          "align-items": "@rule",
          "justify-content": "@rule",
          "flex-grow": "@rule",
          "flex-shrink": "@rule",
          "Margin": "@rule",
          "style": "@rule",
          "flex-size": "@rule",
          "flex-min-width": "@rule",
          "flex-max-width": "@rule"
        }
      ],
      "EnableExpandCollapse": true,
      "ShowExpandCollapseTab": true,
      "ExpandCollapseTabLocation": "outside"
    },
    {
      "divider": true,
      "thickness": "@rule"
    },
    {
      "slot": "content",
      "flex-direction": "column",
      "flex-grow": "@rule",
      "align-items": "@rule",
      "Margin": "@rule",
      "style": "@rule"
    }
  ]
}
