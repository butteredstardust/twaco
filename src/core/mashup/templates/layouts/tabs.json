{
  "name": "tabs",
  "summary": "A title above a tab set; --tab Label=Mashup shows a mashup in each tab",
  "aliases": [
    "tab-page"
  ],
  "page": {
    "flex-direction": "column",
    "align-items": "@rule",
    "Margin": "@rule"
  },
  "children": [
    {
      "slot": "title",
      "flex-direction": "row",
      "align-items": "@rule",
      "fixed": "@rule"
    },
    {
      "slot": "tabs",
      "flex-direction": "row",
      "Scrolling": "auto-scroll",
      "flex-grow": "@rule",
      "align-items": "@rule",
      "widget": "ptcstabset",
      "widget_gutter": "@rule"
    }
  ]
}
