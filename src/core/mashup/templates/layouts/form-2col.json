{
  "name": "form-2col",
  "summary": "Title, full-width fields, and two equal form columns above actions",
  "aliases": [],
  "page": {
    "flex-direction": "column",
    "align-items": "@rule"
  },
  "master_slot": "fields",
  "children": [
    {
      "slot": "title",
      "flex-direction": "row",
      "align-items": "@rule",
      "fixed": "@rule"
    },
    {
      "slot": "fields",
      "flex-direction": "column",
      "flex-grow": "@rule",
      "align-items": "@rule"
    },
    {
      "slot": "form-columns",
      "flex-direction": "row",
      "align-items": "@rule",
      "children": [
        {
          "slot": "left",
          "flex-direction": "column",
          "flex-grow": "@rule",
          "flex-basis": "@rule",
          "align-items": "@rule"
        },
        {
          "slot": "right",
          "flex-direction": "column",
          "flex-grow": "@rule",
          "flex-basis": "@rule",
          "align-items": "@rule"
        }
      ],
      "flex-grow": "@rule"
    },
    {
      "slot": "actions",
      "flex-direction": "row",
      "justify-content": "@rule",
      "align-items": "@rule",
      "fixed": "@rule"
    }
  ]
}
