{
  "name": "tab-content",
  "summary": "Toolbar and body for a tab; the host supplies the title and 24px gutter",
  "page": {
    "flex-direction": "column",
    "align-items": "@rule",
    "Margin": "@rule"
  },
  "children": [
    {
      "slot": "toolbar",
      "flex-direction": "row",
      "align-items": "@rule",
      "fixed": "@rule",
      "Margin": "@rule",
      "style": "@rule"
    },
    {
      "slot": "body",
      "flex-direction": "column",
      "flex-grow": "@rule",
      "align-items": "@rule",
      "Margin": "@rule"
    }
  ]
}
