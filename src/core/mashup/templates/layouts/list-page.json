{
  "name": "list-page",
  "summary": "Title and toolbar above a list body",
  "aliases": [
    "list"
  ],
  "page": {
    "flex-direction": "column",
    "align-items": "stretch"
  },
  "master_slot": "body",
  "children": [
    {
      "slot": "title",
      "flex-direction": "row",
      "align-items": "center",
      "fixed": "70px"
    },
    {
      "slot": "toolbar",
      "flex-direction": "row",
      "align-items": "center",
      "fixed": "50px",
      "style": {
        "background": "#F7F7F7"
      }
    },
    {
      "slot": "body",
      "flex-direction": "column",
      "flex-grow": 1,
      "align-items": "stretch"
    }
  ]
}
