{
  "name": "list-page",
  "summary": "Title and toolbar above a list body",
  "aliases": [
    "list"
  ],
  "page": {
    "flex-direction": "column",
    "align-items": "@rule",
    "Margin": "@rule"
  },
  "master_slot": "body",
  "children": [
    {
      "slot": "title",
      "flex-direction": "row",
      "align-items": "@rule",
      "fixed": "@rule"
    },
    {
      "slot": "toolbar",
      "flex-direction": "row",
      "align-items": "@rule",
      "fixed": "@rule",
      "style": "@rule"
    },
    {
      "slot": "body",
      "flex-direction": "column",
      "flex-grow": "@rule",
      "align-items": "@rule"
    }
  ]
}
