{
  "name": "form-dialog",
  "summary": "Title bar, fields, and a right-aligned action bar",
  "aliases": [
    "form",
    "dialog"
  ],
  "page": {
    "flex-direction": "column",
    "align-items": "@rule"
  },
  "master_slot": "fields",
  "children": [
    {
      "slot": "title",
      "flex-direction": "row",
      "align-items": "@rule",
      "fixed": "@rule"
    },
    {
      "slot": "fields",
      "flex-direction": "column",
      "flex-grow": "@rule",
      "align-items": "@rule"
    },
    {
      "slot": "actions",
      "flex-direction": "row",
      "justify-content": "@rule",
      "align-items": "@rule",
      "fixed": "@rule"
    }
  ]
}
