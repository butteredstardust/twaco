{
  "name": "sidebar-header",
  "summary": "Menu sidebar the full height, a header and the page beside it",
  "aliases": [
    "app-shell"
  ],
  "page": {
    "flex-direction": "row",
    "align-items": "@rule"
  },
  "master_slot": "center",
  "children": [
    {
      "slot": "sidebar",
      "flex-direction": "row",
      "flex-grow": "@rule",
      "align-items": "@rule",
      "widget": "ptcsmenubar"
    },
    {
      "slot": "main",
      "flex-direction": "column",
      "flex-grow": "@rule",
      "align-items": "@rule",
      "children": [
        {
          "slot": "header",
          "flex-direction": "row",
          "align-items": "@rule",
          "justify-content": "@rule",
          "fixed": "@rule"
        },
        {
          "divider": true,
          "thickness": "@rule"
        },
        {
          "slot": "center",
          "flex-direction": "column",
          "flex-grow": "@rule",
          "align-items": "@rule"
        }
      ]
    }
  ]
}
