{
  "name": "kpi-tile",
  "summary": "Compact KPI title and centered value",
  "aliases": [
    "kpi"
  ],
  "page": {
    "flex-direction": "column",
    "align-items": "@rule"
  },
  "master_slot": "value",
  "children": [
    {
      "slot": "title",
      "flex-direction": "row",
      "align-items": "@rule",
      "fixed": "@rule"
    },
    {
      "divider": true,
      "thickness": "@rule"
    },
    {
      "slot": "value",
      "flex-direction": "column",
      "flex-grow": "@rule",
      "justify-content": "@rule",
      "align-items": "@rule"
    }
  ]
}
