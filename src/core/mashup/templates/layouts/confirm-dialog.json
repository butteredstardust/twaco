{
  "name": "confirm-dialog",
  "summary": "Confirmation message with close and action areas",
  "aliases": [
    "confirm"
  ],
  "page": {
    "flex-direction": "column",
    "align-items": "@rule"
  },
  "master_slot": "message",
  "children": [
    {
      "slot": "close",
      "flex-direction": "row",
      "justify-content": "@rule",
      "align-items": "@rule",
      "fixed": "@rule"
    },
    {
      "slot": "message",
      "flex-direction": "column",
      "flex-grow": "@rule",
      "justify-content": "@rule",
      "align-items": "@rule"
    },
    {
      "slot": "actions",
      "flex-direction": "row",
      "justify-content": "@rule",
      "align-items": "@rule",
      "fixed": "@rule"
    }
  ]
}
