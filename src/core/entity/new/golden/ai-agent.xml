                        </FieldDefinitions>
                    </DataShape>
                    <Rows>
                        <Row>
                            <resolverThingName><![CDATA[Acme.Orders.Resolver]]></resolverThingName>
                        </Row>
                    </Rows>
                </ConfigurationTable>
