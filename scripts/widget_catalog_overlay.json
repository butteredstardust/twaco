{
  "comment": "Hand-curated additions to the 10.2 widget catalogue; see scripts/generate_widget_catalog.mjs. type_display_name is Composer's English label (the server translates it, so it is not in the installation's files): the ones seen in exported mashups are copied from them. base_properties apply to every widget.",
  "base_properties": {
    "Visible": {
      "base_type": "BOOLEAN",
      "target": true
    }
  },
  "dropped": {
    "comment": "Properties Composer writes on a widget it drops, after the 10.2 defaults: ptcs on every PTCS widget, flexcontainer on a container. A container gets an empty Margin (the 10.2 default is 5, which nearly no real container keeps and which shrinks fixed bands and hides 1px dividers). ResponsiveLayout is set by the editor (a widget that supports auto-resize fills its container when it is alone in it).",
    "ptcs": {
      "UseTheme": true
    },
    "flexcontainer": {
      "UseTheme": true,
      "iconClass": "widgets-flexcontainer",
      "isLocked": false,
      "ShowVerticalScrollbar": false,
      "Margin": ""
    }
  },
